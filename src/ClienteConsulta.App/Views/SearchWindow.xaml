<Window x:Class="ClienteConsulta.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClienteConsulta.App.ViewModels"
        xmlns:conv="clr-namespace:ClienteConsulta.App.Converters"
        xmlns:models="clr-namespace:ClienteConsulta.Core.Models;assembly=ClienteConsulta.Core"
        Title="Consulta Rápida"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="660"
        WindowStartupLocation="Manual"
        Deactivated="SearchWindow_OnDeactivated"
        PreviewKeyDown="SearchWindow_OnPreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:EnumMatchToVisibilityConverter x:Key="EnumMatch"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
        <conv:InfoIconToGeometryConverter x:Key="InfoIconToGeometry"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
    </Window.InputBindings>

    <Border x:Name="CardBorder" Margin="30" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource WindowShadow}" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho com a marca. A logo (padrão vetorial ou personalizada pelo usuário)
                 é atribuída no code-behind a partir de BrandingProvider; o nome do app só
                 aparece ao lado quando NÃO há logo personalizada. -->
            <Border Grid.Row="0" Height="82" Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="16,16,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="BrandLogo" Height="40" MaxWidth="360" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="BrandName" Text="Consulta Rápida" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Campo de pesquisa -->
            <Grid Grid.Row="1" Margin="18,14,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0"
                      VerticalAlignment="Center" Fill="{StaticResource TextMutedBrush}"
                      Data="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z"/>

                <Grid Grid.Column="1">
                    <TextBlock Text="Pesquisar por nome, CNPJ, CPF, IE ou telefone..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="19"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibility}}"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_OnPreviewKeyDown"/>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="{StaticResource DividerBrush}" Margin="18,0"/>

            <!-- Conteúdo: lista de resultados / detalhes / erro -->
            <Grid Grid.Row="3">

                <!-- Lista de resultados -->
                <Grid Visibility="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=List}">
                    <ListBox x:Name="ResultsListBox"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex}"
                             Style="{StaticResource ResultsListBoxStyle}"
                             ItemContainerStyle="{StaticResource ResultListBoxItemStyle}"
                             MaxHeight="420"
                             Focusable="False"
                             MouseLeftButtonUp="ResultsListBox_OnMouseLeftButtonUp"
                             Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Customer}">
                                <StackPanel>
                                    <TextBlock Text="{Binding RazaoSocial}" FontFamily="{StaticResource BodyFont}"
                                               FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                        <Run Text="{Binding DocumentoFormatado, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding Municipio, Mode=OneWay}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding UF, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Margin="0,36,0,40"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="Nenhum cliente encontrado" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Detalhes do cliente -->
                <Grid Visibility="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Detail}"
                      Margin="18,4,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{Binding BackCommand}"
                                VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="Voltar (Esc)">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M20,11 L7.83,11 L13.42,5.41 L12,4 L4,12 L12,20 L13.41,18.59 L7.83,13 L20,13 Z"/>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding CurrentCustomer.RazaoSocial}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox x:Name="DetailFieldsList" Grid.Row="1"
                             ItemsSource="{Binding DetailFields}"
                             SelectedIndex="{Binding SelectedFieldIndex}"
                             Style="{StaticResource FieldRowListBoxStyle}"
                             ItemContainerStyle="{StaticResource FieldRowListBoxItemStyle}"
                             MaxHeight="380"
                             PreviewKeyDown="DetailFieldsList_OnPreviewKeyDown"
                             MouseLeftButtonUp="DetailFieldsList_OnMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CopyableField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Campo normal -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                Visibility="{Binding IsNormalField, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource BodyFont}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource BodyFont}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Item "+ Informações" -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsMoreInfo, Converter={StaticResource BoolToVisibility}}">
                                        <Path Data="{StaticResource Icon.MoreInfo}" Style="{StaticResource InfoFieldIconStyle}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Mais informações" FontFamily="{StaticResource BodyFont}" FontSize="14.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" VerticalAlignment="Center" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Command" Value="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMoreInfo}" Value="True">
                                                        <Setter Property="Command" Value="{Binding DataContext.OpenFullDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <!-- Copiar / Copiado (campos normais) -->
                                            <Grid Visibility="{Binding IsMoreInfo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <Grid Width="13" Height="13" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" BorderBrush="{StaticResource TextSecondaryBrush}"
                                                                BorderThickness="1.3" CornerRadius="2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Background="{StaticResource SurfaceAltBrush}"/>
                                                        <Border Width="9" Height="9" BorderBrush="{StaticResource TextSecondaryBrush}"
                                                                BorderThickness="1.3" CornerRadius="2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Background="{StaticResource SurfaceAltBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="Copiar" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="&#x2713;" FontSize="12.5" FontWeight="Bold" Margin="0,0,5,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="Copiado" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Seta (item "+ Informações") -->
                                            <Path Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" Stretch="Uniform"
                                                  Fill="Transparent" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Visibility="{Binding IsMoreInfo, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Tela "+ Informações": todos os dados disponíveis da empresa, agrupados por seção -->
                <Grid Visibility="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=FullDetail}"
                      Margin="18,4,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{Binding BackCommand}"
                                VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="Voltar (Esc)">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M20,11 L7.83,11 L13.42,5.41 L12,4 L4,12 L12,20 L13.41,18.59 L7.83,13 L20,13 Z"/>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding CurrentCustomer.RazaoSocial}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox x:Name="FullDetailFieldsList" Grid.Row="1"
                             ItemsSource="{Binding FullDetailFields}"
                             SelectedIndex="{Binding SelectedFullDetailFieldIndex}"
                             Style="{StaticResource FieldRowListBoxStyle}"
                             ItemContainerStyle="{StaticResource InfoFieldListBoxItemStyle}"
                             MaxHeight="460"
                             PreviewKeyDown="FullDetailFieldsList_OnPreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoField}">
                                <Grid>
                                    <!-- Cabeçalho de seção -->
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource BodyFont}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding IsSectionHeader, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- Campo -->
                                    <Grid Visibility="{Binding IsSectionHeader, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource PrimarySoftBrush}"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Path Data="{Binding Icon, Converter={StaticResource InfoIconToGeometry}}"
                                                  Style="{StaticResource InfoFieldIconStyle}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource BodyFont}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource BodyFont}" FontSize="14.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.CopyFullDetailFieldCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <Grid Width="13" Height="13" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" BorderBrush="{StaticResource TextSecondaryBrush}"
                                                                BorderThickness="1.3" CornerRadius="2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Background="{StaticResource SurfaceAltBrush}"/>
                                                        <Border Width="9" Height="9" BorderBrush="{StaticResource TextSecondaryBrush}"
                                                                BorderThickness="1.3" CornerRadius="2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Background="{StaticResource SurfaceAltBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="Copiar" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="&#x2713;" FontSize="12.5" FontWeight="Bold" Margin="0,0,5,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="Copiado" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Estado de erro / base ainda vazia -->
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                            Margin="30,34,30,38" HorizontalAlignment="Center">
                    <TextBlock Text="Nada para mostrar ainda" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage}" FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,8,0,16" MaxWidth="420"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Abrir Configurações" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"/>
                        <Button Content="Tentar novamente" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Rodapé com atalhos -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding FooterHintText}" FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}" Margin="18,9" HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </Border>
</Window>
