<Window x:Class="ClienteConsulta.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Margin="20" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource WindowShadow}">
        <StackPanel Margin="24">

            <Grid>
                <TextBlock Text="Configurações" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="AppNameText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           FontFamily="{StaticResource BodyFont}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <!-- ===================== Base de dados ===================== -->
            <TextBlock Text="Base de clientes" FontFamily="{StaticResource BodyFont}"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,18,0,8"/>

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="CustomerCountText" FontFamily="{StaticResource BodyFont}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DbPathText" FontFamily="{StaticResource BodyFont}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                       Text="Os dados ficam guardados dentro do aplicativo. Use &quot;Importar clientes...&quot; para carregar (ou atualizar) toda a base a partir do relatório de empresas do sistema Domínio."/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RegisterStatusText" Grid.Column="0" FontFamily="{StaticResource BodyFont}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="RegisterButton" Grid.Column="1" Content="+ Cadastrar nova empresa"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="RegisterButton_OnClick"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="{StaticResource BodyFont}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Substitui toda a base pelo relatório da Domínio"/>
                <Button x:Name="ImportButton" Grid.Column="1" Content="Importar clientes..."
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="ImportButton_OnClick"/>
            </Grid>

            <!-- ===================== Aparência ===================== -->
            <TextBlock Text="Aparência" FontFamily="{StaticResource BodyFont}"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border x:Name="ColorSwatch" CornerRadius="7" Background="{DynamicResource PrimaryBrush}"/>
                </Border>

                <TextBox x:Name="AccentHexBox" Grid.Column="1" Style="{StaticResource DialogTextBoxStyle}"
                         MaxLength="7" VerticalContentAlignment="Center"
                         TextChanged="AccentHexBox_OnTextChanged"/>
            </Grid>

            <ItemsControl x:Name="PresetSwatches" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="26" Height="26" Margin="0,0,7,0" Cursor="Hand"
                                ToolTip="{Binding Name}" Tag="{Binding Hex}" Click="PresetSwatch_OnClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{Binding Brush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="120" Height="44" CornerRadius="8" Margin="0,0,12,0"
                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Image x:Name="LogoPreview" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Grid.Column="1" FontFamily="{StaticResource BodyFont}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           Text="Logo do cabeçalho. PNG com fundo transparente funciona melhor. Sem logo própria, aparece a marca padrão."/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Escolher logo..." Style="{StaticResource SecondaryButtonStyle}"
                            Click="ChooseLogoButton_OnClick"/>
                    <Button x:Name="DefaultLogoButton" Content="Usar logo padrão" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,6,0,0" Click="DefaultLogoButton_OnClick"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="AppearanceStatusText" FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                       Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- ===================== Atalho ===================== -->
            <TextBlock Text="Atalho global para abrir a pesquisa" FontFamily="{StaticResource BodyFont}"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="HotKeyBox" Grid.Column="0" Style="{StaticResource DialogTextBoxStyle}"
                         IsReadOnly="True" Cursor="Hand" HorizontalContentAlignment="Center"
                         FontWeight="SemiBold" Focusable="True"
                         GotFocus="HotKeyBox_OnGotFocus" LostFocus="HotKeyBox_OnLostFocus"
                         PreviewKeyDown="HotKeyBox_OnPreviewKeyDown"/>
                <Button Grid.Column="1" Content="Padrão" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0" Click="ResetHotKeyButton_OnClick"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_OnClick" Margin="0,0,10,0"/>
                <Button Content="Salvar" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
